<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.todo.mapper.user.UserMapper">

    <select id="selectByEmail" resultType="com.todo.entity.user.User">
        SELECT * FROM t_user WHERE email = #{email} AND delete_flag = 0
    </select>

</mapper>
